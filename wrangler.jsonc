{
  "name": "smallflower-web",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "smallflower.tw", "custom_domain": true },
    { "pattern": "www.smallflower.tw", "custom_domain": true }
  ]
}
