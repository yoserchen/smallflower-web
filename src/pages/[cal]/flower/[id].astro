---
import Base from '../../../layouts/Base.astro';
import Row from '../../../components/Row.astro';
import { LIVE_CALENDARS, speciesOf, liveOf, monthsOf, yearsOf, has, photosOf, zoneMapUrl } from '../../../lib.mjs';
import { MONTHS, AUTHOR } from '../../../config.mjs';
export function getStaticPaths() {
  return LIVE_CALENDARS.flatMap((c) =>
    speciesOf(c.slug).map((s) => ({ params: { cal: c.slug, id: s.id }, props: { cal: c, s } }))
  );
}
const { cal, s } = Astro.props;
const ms = monthsOf(s), ys = yearsOf(s);
const pics = photosOf(cal.slug, s);
const zoneUrl = zoneMapUrl(cal.slug, s.z);
const share = pics && pics.ph.length ? `/p/${pics.s}/${pics.ph[0].i}.jpg` : '/og.jpg';
const sheets = [...new Set(s.no.map((n) => n.split('-')[0]))];
const nearby = liveOf(cal.slug).filter((x) => x.z && x.z === s.z && x.id !== s.id && ms.some((m) => has(x, m))).slice(0, 8);
const desc = `${s.n}：在${cal.place}${ms.length ? ms.join('、') + ' 月' : ''}拍到開花${s.z ? '，位於' + s.z : ''}。`;
---
<Base title={s.n} cal={cal} description={desc} image={share} imageAlt={`${s.n}｜${AUTHOR}攝`}>
  <section>
    <p class="crumb"><a href={`/${cal.slug}/`}>{cal.name}</a>{s.z && <span> ／ {s.z}</span>}</p>
    <h1>{s.n}</h1>
    {s.st !== '現存' && (
      <p class="warn">{s.st === '近年未見'
        ? `近年未見：最後一次拍到是 ${s.last.slice(0, 7).replace('-', ' 年 ')} 月，地圖上沒有標。`
        : '這一株已經不在園區了，記錄保留供參考。'}</p>
    )}
    {pics ? (
      <figure class="gal" data-n={pics.ph.length} id="gal">
        {pics.ph.map((p, k) => (
          <a class={k === 0 ? 'big' : ''} href={`/p/${pics.s}/${p.i}.jpg`}
             data-k={k} data-full={`/p/${pics.s}/${p.i}.jpg`}
             data-date={p.d ? p.d.replace('-', ' 年 ').replace('-', ' 月 ') + ' 日' : ''}>
            <img src={`/p/${pics.s}/${p.i}${k === 0 ? '' : 't'}.jpg`} alt={`${s.n}　${p.d}`}
                 loading={k === 0 ? 'eager' : 'lazy'} decoding="async" />
            {p.d && <span class="cap">{k === 0
              ? p.d.replace('-', ' 年 ').replace('-', ' 月 ') + ' 日'
              : p.d.slice(0, 7).replace('-', '.')}</span>}
          </a>
        ))}
        <figcaption>點照片看大圖{pics.ph.length > 1 && '，可以左右切換'}</figcaption>
      </figure>
    ) : (
      <div class="photo"><span>照片準備中</span></div>
    )}
    {s.t && (
      <div class="note-box">
        <h2>{AUTHOR}對這朵花的印象</h2>
        {s.t.split(/\n+/).map((para) => <p>{para}</p>)}
      </div>
    )}
    <h2>開花月份</h2>
    <div class="big">
      {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
        <a href={`/${cal.slug}/month/${m}/`} class={has(s, m) ? 'b' : ''} aria-label={`${MONTHS[m - 1]}開的花`}><i></i>{m}月</a>
      ))}
    </div>
    <dl class="facts">
      {s.no.length > 0 && (
        <>
          <dt>地圖編號</dt>
          <dd>
            {s.no.map((n) => <span class="no">{n}</span>)}
            <small>（第 {sheets.map((k) => `${k} 張${cal.sheets?.[k] || ''}`).join('、')}）</small>
          </dd>
        </>
      )}
      {s.z && (
        <>
          <dt>區域</dt>
          <dd>
            {s.z}{s.i && `，${s.i}內`}
            {zoneUrl && <a class="gmap" href={zoneUrl} target="_blank" rel="noopener">在 Google 地圖看這一區 ↗</a>}
          </dd>
        </>
      )}
      <dt>拍到的年份</dt>
      <dd class="yrs">{[2023, 2024, 2025, 2026].map((y) => <span class={ys.includes(y) ? 'y' : ''}>{y}</span>)}</dd>
      <dt>記錄數</dt><dd>{s.c} 筆</dd>
      {s.p && <><dt>記錄部位</dt><dd>{s.p}</dd></>}
    </dl>
    {cal.hasMap && <p class="note">網站上的位置只標到區域。每一株的精確位置印在口袋地圖上。</p>}
  </section>
  {nearby.length > 0 && (
    <section>
      <h2>同一區、同時期開的花</h2>
      <div class="list">{nearby.map((x) => <Row s={x} slug={cal.slug} />)}</div>
    </section>
  )}
  {pics && (
    <div id="lb" hidden data-n={pics.ph.length}>
      <button class="x" type="button" aria-label="關閉">&#10005;</button>
      <button class="nav prev" type="button" aria-label="上一張">&#8249;</button>
      <img id="lbimg" alt="" />
      <button class="nav next" type="button" aria-label="下一張">&#8250;</button>
      <p class="meta"><span id="lbdate"></span><span id="lbn"></span></p>
    </div>
  )}
  {pics && (
    <script is:inline>
    (function () {
      var gal = document.getElementById('gal');
      var lb = document.getElementById('lb');
      if (!gal || !lb) return;
      var links = [].slice.call(gal.querySelectorAll('a[data-full]'));
      var img = document.getElementById('lbimg');
      var dateEl = document.getElementById('lbdate');
      var nEl = document.getElementById('lbn');
      var cur = 0;
      function show(i) {
        cur = (i + links.length) % links.length;
        var a = links[cur];
        img.src = a.dataset.full;
        img.alt = a.querySelector('img').alt;
        dateEl.textContent = a.dataset.date || '';
        nEl.textContent = links.length > 1 ? (cur + 1) + ' / ' + links.length : '';
      }
      function open(i) {
        show(i);
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lb.hidden = true;
        document.body.style.overflow = '';
      }
      links.forEach(function (a, i) {
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          e.preventDefault(); open(i);
        });
      });
      lb.querySelector('.x').addEventListener('click', close);
      lb.querySelector('.prev').addEventListener('click', function (e) { e.stopPropagation(); show(cur - 1); });
      lb.querySelector('.next').addEventListener('click', function (e) { e.stopPropagation(); show(cur + 1); });
      lb.addEventListener('click', function (e) { if (e.target === lb || e.target === img) close(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(cur - 1);
        if (e.key === 'ArrowRight') show(cur + 1);
      });
      var x0 = null;
      lb.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      lb.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
        x0 = null;
      }, { passive: true });
    })();
    </script>
  )}
</Base>
<style>
.crumb{font-size:14px;color:var(--leaf);margin:24px 0 4px}
.crumb a{color:var(--leaf)}
.warn{color:var(--bloom);font-size:15px;margin:0 0 8px}
.gal{margin:14px 0 30px;display:grid;gap:8px;max-width:760px;
  grid-template-columns:repeat(3,1fr)}
.gal .big{grid-column:1/-1}
.gal[data-n="1"]{grid-template-columns:1fr}
.gal a{position:relative;display:block;border-radius:12px;overflow:hidden;background:var(--mist);line-height:0}
.gal a img{width:100%;height:100%;object-fit:cover;display:block}
.gal .big img{aspect-ratio:4/3}
.gal a:not(.big) img{aspect-ratio:1}
.gal .cap{position:absolute;left:0;right:0;bottom:0;padding:14px 10px 6px;font-size:12px;line-height:1.4;
  color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.55));opacity:0;transition:opacity .15s}
.gal .big .cap{font-size:13px;opacity:1}
.gal a:hover .cap,.gal a:focus-visible .cap{opacity:1}
.gal figcaption{grid-column:1/-1;font-size:13px;color:var(--leaf);margin-top:2px}
@media (max-width:560px){.gal{gap:6px}.gal .cap{opacity:1}}
#lb{position:fixed;inset:0;z-index:50;background:rgba(10,16,13,.94);
  display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:16px}
#lb[hidden]{display:none}
#lb img{grid-column:2;max-width:100%;max-height:86vh;margin:0 auto;display:block;
  object-fit:contain;border-radius:8px;cursor:zoom-out}
#lb .meta{grid-column:1/-1;grid-row:2;text-align:center;color:#D6E0D3;font-size:14px;margin:10px 0 0;
  display:flex;gap:14px;justify-content:center}
#lb .x{position:absolute;top:14px;right:16px;width:42px;height:42px;border-radius:50%;
  border:0;background:rgba(255,255,255,.12);color:#fff;font-size:18px;cursor:pointer;line-height:1}
#lb .nav{width:52px;height:78px;border:0;border-radius:10px;background:rgba(255,255,255,.1);
  color:#fff;font-size:34px;cursor:pointer;line-height:1}
#lb .nav:hover,#lb .x:hover{background:rgba(255,255,255,.22)}
#lb[data-n="1"] .nav{visibility:hidden}
.gal a{cursor:zoom-in}
@media (max-width:620px){#lb{padding:10px;gap:4px}#lb .nav{width:40px;height:64px;font-size:26px}}
.photo{aspect-ratio:3/2;max-width:640px;background:var(--mist);border-radius:16px;display:flex;align-items:center;justify-content:center;color:var(--leaf);margin:12px 0 28px}
.note-box{max-width:38em;margin:0 0 28px;padding:16px 20px 18px;background:var(--panel);
  border:1px solid var(--mist);border-left:3px solid var(--bloom);border-radius:12px}
.note-box h2{font-size:15px;font-family:var(--sans);font-weight:700;color:var(--leaf);
  letter-spacing:.04em;margin:0 0 8px}
.note-box p{margin:0 0 .7em;font-size:16.5px;line-height:1.85}
.note-box p:last-child{margin-bottom:0}
.big{display:grid;grid-template-columns:repeat(12,1fr);gap:4px;max-width:560px;margin:6px 0 20px}
.big a{text-align:center;font-size:12px;color:var(--leaf);text-decoration:none}
.big a i{display:block;height:26px;border-radius:4px;background:var(--mist);margin-bottom:3px}
.big a.b i{background:var(--leaf)}
.big a:hover i{outline:2px solid var(--bloom)}
.facts{display:grid;grid-template-columns:max-content 1fr;gap:6px 18px;font-size:16px;margin:0}
.facts dt{color:var(--leaf)}
.facts dd{margin:0}
.facts .no{display:inline-block;font-weight:700;color:var(--bloom);margin-right:10px;font-variant-numeric:tabular-nums}
.facts small{color:var(--leaf)}
.yrs span{display:inline-block;margin-right:6px;padding:0 6px;border-radius:4px;font-size:13px;background:var(--mist);color:var(--leaf)}
.yrs span.y{background:var(--ink);color:var(--paper)}
.note{font-size:14px;color:var(--leaf);margin-top:14px}
.gmap{display:inline-block;margin-left:10px;font-size:13.5px;white-space:nowrap}
</style>
