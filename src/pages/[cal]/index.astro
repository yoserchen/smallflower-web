---
import Base from '../../layouts/Base.astro';
import Clock from '../../components/Clock.astro';
import { LIVE_CALENDARS, liveOf, speciesOf, monthCountOf, byNo, photosOf } from '../../lib.mjs';
import { SPONSOR_1000_URL } from '../../config.mjs';
export function getStaticPaths() {
  return LIVE_CALENDARS.map((c) => ({ params: { cal: c.slug }, props: { cal: c } }));
}
const { cal } = Astro.props;
const live = liveOf(cal.slug);
const counts = monthCountOf(cal.slug);
// 數字一律從資料算，不要寫死
const sp = speciesOf(cal.slug);
const shots = Math.round(sp.reduce((a, s) => a + (s.c || 0), 0));
const onMap = new Set(sp.flatMap((s) => s.no || [])).size;
const nf = (n) => n.toLocaleString('en-US');
const mini = live.slice().sort(byNo).map((s) => {
  const p = photosOf(cal.slug, s);
  return [s.n, s.n, s.m, s.no[0] || '', s.z, s.i, p && p.ph.length ? p.s : ''];
});
---
<Base cal={cal} description={`${cal.intro}共 ${live.length.toLocaleString()} 種。`}>
  <div class="hero">
    <Clock counts={counts} slug={cal.slug} active={0} total={live.length} />
    <div>
      <h1>{cal.name}</h1>
      <p class="lead">{cal.place}有一千多種花，走進去，多半只看得到一片綠。<br />
        這三年我每週進園，把看到的花一株一株拍下來，
        記下它叫什麼、什麼時候開、開在哪裡。</p>
      <ul class="nums">
        <li><b>{nf(live.length)}</b><span>種花</span></li>
        <li><b>{nf(shots)}</b><span>筆開花記錄</span></li>
        {cal.hasMap && onMap > 0 && <li><b>{nf(onMap)}</b><span>株標進地圖</span></li>}
      </ul>
      <p class="now" id="now"></p>
      <div class="search">
        <input id="q" type="search" placeholder={cal.hasMap ? '搜尋花名或地圖編號，例如 4-157' : '搜尋花名'} aria-label="搜尋" autocomplete="off" />
      </div>
      <div class="hint">點花鐘的花瓣，看那個月開的花。</div>
    </div>
  </div>
  <section>
    <h2 id="listTitle"></h2>
    <p class="sub">{cal.hasMap ? '依地圖編號排列，前面的數字是第幾張地圖。' : '依花名排列。'}點一種花看它幾月開、在哪一區。</p>
    <div class="list" id="list"></div>
    <p><a class="btn" id="more" href={`/${cal.slug}/month/`}>看完整月份清單</a></p>
  </section>
  {cal.hasMap && (
    <section class="how">
      <h2>在現場，怎麼知道這是什麼花</h2>
      <ol>
        <li>走著走著，看到一朵花，不知道它叫什麼</li>
        <li>翻開找花地圖，找到你站的位置，看那一株的編號</li>
        <li>編號背面就是花名和花季，當場就知道</li>
        <li>想看它別的季節長什麼樣，回到這裡輸入編號</li>
      </ol>
      <p class="note">你不需要先認識植物。帶著地圖走進植物園，開始找就好。</p>
      <p class="cta"><a class="btn solid" href={`/${cal.slug}/map/`}>我要一份找花地圖</a></p>
    </section>
  )}
  <script type="application/json" id="mini" set:html={JSON.stringify(mini)}></script>
  <script type="application/json" id="cfg" set:html={JSON.stringify({ slug: cal.slug })}></script>
  <script is:inline>
  (function () {
    var D = JSON.parse(document.getElementById('mini').textContent);
    var SLUG = JSON.parse(document.getElementById('cfg').textContent).slug;
    var MN = ['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
    var m = new Date().getMonth() + 1, q = '';
    document.querySelectorAll('.clock .petal, .clock .mlab').forEach(function (e) {
      if (+e.dataset.m === m) e.classList.add('on');
    });
    var has = function (x) { return (x[2] >> (m - 1)) & 1; };
    var cnt = D.filter(has).length;
    document.getElementById('clockMonth').textContent = MN[m - 1];
    document.getElementById('clockCount').textContent = cnt + ' 種';
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function rib(x) {
      var h = '<span class="rib" aria-hidden="true">';
      for (var k = 1; k <= 12; k++) { var b = (x[2] >> (k - 1)) & 1; h += '<i class="' + (b ? 'b' : '') + (b && k === m ? ' cur' : '') + '"></i>'; }
      return h + '</span>';
    }
    function norm(v) {
      return v.replace(/[－—–\s]/g, '-').replace(/[０-９]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 65248); });
    }
    function render() {
      var nq = norm(q), pool;
      if (q) pool = D.filter(function (x) { return x[1].indexOf(q) >= 0 || (x[3] && x[3].indexOf(nq) === 0); });
      else pool = D.filter(has);
      document.getElementById('now').innerHTML = q
        ? '搜尋「' + esc(q) + '」，找到 <b>' + pool.length + '</b> 種'
        : MN[m - 1] + '有 <b>' + cnt + '</b> 種花開著';
      document.getElementById('listTitle').textContent = q ? '搜尋結果' : MN[m - 1] + '開的花';
      var more = document.getElementById('more');
      more.href = q ? '/' + SLUG + '/month/' : '/' + SLUG + '/month/' + m + '/';
      more.textContent = q ? '看完整月份清單' : '看' + MN[m - 1] + '全部 ' + cnt + ' 種';
      var out = pool.slice(0, q ? 80 : 40);
      document.getElementById('list').innerHTML = out.length
        ? out.map(function (x) {
            return '<a class="row" href="/' + SLUG + '/flower/' + encodeURIComponent(x[0]) + '/">'
              + '<span class="code' + (x[3] ? '' : ' none') + '">' + (x[3] || '—') + '</span>'
              + '<span class="thumb">' + (x[6]
                  ? '<img loading="lazy" decoding="async" width="48" height="48" alt="" src="/p/' + x[6] + '/1t.jpg" />'
                  : '<i></i>') + '</span>'
              + '<span class="nm">' + esc(x[1]) + (x[5] ? '<span class="tag">' + esc(x[5]) + '內</span>' : '') + '</span>'
              + '<span class="zn">' + esc(x[4]) + '</span>' + rib(x) + '</a>';
          }).join('')
        : '<div class="empty">找不到。試試只打兩三個字。</div>';
    }
    document.getElementById('q').addEventListener('input', function (e) { q = e.target.value.trim(); render(); });
    render();
  })();
  </script>
</Base>
<style>
.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:40px;align-items:center;padding:40px 0 16px}
@media (max-width:820px){.hero{grid-template-columns:1fr;gap:8px;padding-top:24px}.hero>div{order:-1}.hero :global(.clock){max-width:340px}}
.lead{max-width:30em;line-height:1.9}
.nums{list-style:none;display:flex;flex-wrap:wrap;gap:8px 26px;padding:0;margin:18px 0 20px}
.nums li{display:flex;align-items:baseline;gap:5px}
.nums b{font-family:var(--serif);font-size:26px;color:var(--bloom);
  font-variant-numeric:tabular-nums;line-height:1.1}
.nums span{font-size:13px;color:var(--leaf)}
.how{border-top:1px solid var(--mist);padding-top:28px;margin-top:40px}
.how h2{font-family:var(--serif);font-size:22px;margin:0 0 14px}
.how ol{max-width:34em;margin:0;padding-left:1.35em;line-height:2}
.how ol li::marker{color:var(--bloom);font-weight:700}
.how .note{color:var(--leaf);margin:14px 0 18px}
.how .cta{margin:0}
.how .cta .btn{display:inline-block;text-decoration:none}
.now{font-family:var(--serif);font-size:clamp(20px,3vw,26px);font-weight:700;margin:0 0 16px}
.now :global(b){color:var(--bloom);font-weight:900}
</style>
