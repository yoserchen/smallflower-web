---
import Base from '../../layouts/Base.astro';
import { LIVE_CALENDARS, speciesOf } from '../../lib.mjs';
import { SPONSOR_1000_URL, AUTHOR } from '../../config.mjs';
export function getStaticPaths() {
  return LIVE_CALENDARS.filter((c) => c.hasMap).map((c) => ({ params: { cal: c.slug }, props: { cal: c } }));
}
const { cal } = Astro.props;
const idx = {};
speciesOf(cal.slug).forEach((s) => s.no.forEach((n) => { idx[n] = [s.id, s.n]; }));
const cnt = {};
Object.keys(idx).forEach((n) => { const k = n.split('-')[0]; cnt[k] = (cnt[k] || 0) + 1; });
const total = Object.keys(idx).length;
---
<Base title={`${cal.place}找花地圖`} cal={cal} current="map"
      image="/map/preview.png" imageAlt={`${cal.place}找花地圖的一角：荷花池周邊，每一株花一個編號`}
      description={`${cal.place}找花地圖：把每一株花標在紙上，配一個編號。手上有地圖的話，在這裡輸入編號就能查到那是什麼花。`}>
  <section>
    <h1>{cal.place}找花地圖</h1>
    <p class="sub">帶著它走進植物園，你會開始看見花。<br />
      {total.toLocaleString('en-US')} 株花標在圖上，每一株一個編號——不必先認得它，也查得到它叫什麼。</p>

    <figure class="peek">
      <img src="/map/preview.png" width="1400" height="875" loading="lazy" decoding="async"
           alt={`找花地圖的一角：${cal.place}荷花池周邊，每一株花標一個編號`} />
      <figcaption>地圖的一角——荷花池周邊。每一個點是一株花，旁邊的號碼對照背面的花名。</figcaption>
    </figure>

    <div class="steps">
      <h2>在現場怎麼用</h2>
      <ol>
        <li>看到一朵不知道名字的花</li>
        <li>翻開地圖，找到你站的位置，看那一株的編號</li>
        <li>翻到背面，編號旁邊就是花名和它幾月開</li>
        <li>想看它開花的樣子，回到這一頁輸入編號</li>
      </ol>
    </div>

    <div class="lookup">
      <h2>手上有地圖，要查編號</h2>
      <form id="f" class="search" onsubmit="return false">
        <input id="n" inputmode="numeric" placeholder="例如 4-157" aria-label="地圖編號" autocomplete="off" />
      </form>
      <p id="r" class="hint" aria-live="polite">輸入地圖上的編號。前面的數字是第幾張，後面是號碼。</p>
    </div>

    <h2>這不是一張普通的植物園地圖</h2>
    <p>{cal.place}有一千多種花，可是走進去，多半只看得到一片綠。
      這份地圖把{AUTHOR}三年來一株一株實際拍到的花標在圖上，
      不是把園區分成幾個大區塊而已——是每一株都有自己的號碼。</p>
    <p>它跟線上的花曆是一套：紙本告訴你「這裡有一株」，
      網站告訴你「它長什麼樣、幾月開」。花會一直開，花曆也會繼續更新。</p>
    <p>分成四張，可以只帶當天要走的那一張：</p>
    <div class="sheets">
      {Object.entries(cal.sheets || {}).map(([k, v]) => (
        <div class="sh"><b>第 {k} 張</b><span>{v}</span><small>{cnt[k] || 0} 株</small></div>
      ))}
    </div>
    <p class="note">這份地圖目前印刷製作中。</p>

    <div class="warn">
      <b>小提醒</b>
      <p>花期會受到天候與環境影響，網站上的月份是{AUTHOR}實際拍到開花的記錄，
        並不代表每一年都會在同一時間開花。</p>
      <p>花點位置是實際觀察與整理後的區域標示，提供找花參考，並非官方測量座標。</p>
      <p>這份花曆與地圖是{AUTHOR}個人長期記錄的成果，歡迎大家使用，
        也歡迎發現錯誤時告訴我。</p>
    </div>

    <div class="get">
      <h2>想要一份</h2>
      <p>這份地圖不做販售，也不會在其他地方流通。印刷和寄送都是{AUTHOR}自己出的，
        只留給贊助 1000 元的朋友，地圖出版時親送或寄送給您。</p>
      <a class="btn solid" href={SPONSOR_1000_URL} target="_blank" rel="noopener">我要取得一份找花地圖</a>
      <p class="hint">也可以先看看<a href="/support/">其他支持方式</a>。</p>
    </div>
  </section>
  <script type="application/json" id="idx" set:html={JSON.stringify(idx)}></script>
  <script type="application/json" id="cfg" set:html={JSON.stringify({ slug: cal.slug })}></script>
  <script is:inline>
  (function () {
    var I = JSON.parse(document.getElementById('idx').textContent);
    var SLUG = JSON.parse(document.getElementById('cfg').textContent).slug;
    var n = document.getElementById('n'), r = document.getElementById('r');
    var TIP = r.textContent;
    function norm(v) {
      v = v.replace(/[－—–\s]/g, '-').replace(/[０-９]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 65248); });
      var m = v.match(/^(\d)\D*(\d{1,3})$/);
      return m ? m[1] + '-' + Number(m[2]) : v;
    }
    function go() {
      var k = norm(n.value.trim());
      if (!k) { r.textContent = TIP; return; }
      var h = I[k];
      if (h) r.innerHTML = '<a href="/' + SLUG + '/flower/' + encodeURIComponent(h[0]) + '/">' + k + '　' + h[1] + '</a>';
      else r.textContent = '找不到 ' + k + '，請確認張號和號碼。';
    }
    n.addEventListener('input', go);
    document.getElementById('f').addEventListener('submit', function () {
      var h = I[norm(n.value.trim())];
      if (h) location.href = '/' + SLUG + '/flower/' + encodeURIComponent(h[0]) + '/';
    });
    var p = new URLSearchParams(location.search).get('n');
    if (p) { n.value = p; go(); }
  })();
  </script>
</Base>
<style>
h2{font-family:var(--serif);font-size:22px;margin:34px 0 10px}
.peek{margin:20px 0 0}
.peek img{display:block;width:100%;height:auto;border:1px solid var(--mist);border-radius:14px;
  background:var(--panel)}
.peek figcaption{color:var(--leaf);font-size:13.5px;margin-top:8px;line-height:1.7}
.lookup{border:1px solid var(--mist);border-radius:16px;padding:18px 20px 6px;background:var(--panel);
  margin:22px 0 0}
.lookup h2{margin:0 0 10px;font-size:19px}
.sheets{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-top:14px}
.sh{padding:14px 0;display:grid;gap:2px;border-top:1px solid var(--mist)}
.sh b{font-family:var(--serif);font-size:19px;font-weight:700}
.sh small{color:var(--leaf)}
.note{color:var(--leaf);font-size:14px;margin-top:18px}
.get{margin-top:36px;border-top:1px solid var(--mist);padding-top:6px}
.get .btn{display:inline-block;text-decoration:none;margin-top:4px}
.get .hint{margin-top:12px}
.steps{border-top:1px solid var(--mist);margin-top:30px;padding-top:6px}
.steps ol{max-width:34em;margin:0;padding-left:1.35em;line-height:2}
.steps ol li::marker{color:var(--bloom);font-weight:700}
.warn{border:1px solid var(--mist);border-radius:14px;padding:16px 18px 4px;
  background:var(--panel);margin-top:22px}
.warn b{font-family:var(--serif);font-size:16px}
.warn p{font-size:14px;color:var(--leaf);line-height:1.85;margin:8px 0 12px}
</style>
