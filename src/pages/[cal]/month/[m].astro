---
import Base from '../../../layouts/Base.astro';
import Clock from '../../../components/Clock.astro';
import Row from '../../../components/Row.astro';
import { LIVE_CALENDARS, liveOf, monthCountOf, has, byNo, photosOf } from '../../../lib.mjs';
import { MONTHS } from '../../../config.mjs';
export function getStaticPaths() {
  return LIVE_CALENDARS.flatMap((c) =>
    Array.from({ length: 12 }, (_, i) => ({ params: { cal: c.slug, m: String(i + 1) }, props: { cal: c } }))
  );
}
const { cal } = Astro.props;
const m = Number(Astro.params.m);
const counts = monthCountOf(cal.slug);
const live = liveOf(cal.slug);
const list = live.filter((s) => has(s, m)).sort(byNo);
const zones = [...new Set(list.map((s) => s.z).filter(Boolean))].sort();
const first = list.map((x) => photosOf(cal.slug, x)).find((p) => p && p.ph.length);
const share = first ? `/p/${first.s}/${first.ph[0].i}.jpg` : '/og.jpg';
---
<Base title={`${MONTHS[m - 1]}開的花`} cal={cal} current="month"
      description={`${cal.place}${MONTHS[m - 1]}開的 ${list.length} 種花。`} image={share}>
  <div class="hero">
    <Clock counts={counts} slug={cal.slug} active={m} total={live.length} />
    <div>
      <h1>{MONTHS[m - 1]}開的花</h1>
      <p class="count">{cal.place}有 <b>{list.length}</b> 種</p>
      <p class="sub">{cal.note}</p>
      <p class="hint">點花鐘的其他花瓣換月份。</p>
    </div>
  </div>
  <section>
    {zones.length > 1 && (
      <div class="chips" id="zf" role="group" aria-label="篩選區域">
        <button class="chip" aria-pressed="true" data-z="">全部<small> {list.length}</small></button>
        {zones.map((z) => (
          <button class="chip" aria-pressed="false" data-z={z}>{z}<small> {list.filter((s) => s.z === z).length}</small></button>
        ))}
      </div>
    )}
    <div class="list">{list.map((s) => <Row s={s} slug={cal.slug} cur={m} />)}</div>
  </section>
  <script is:inline>
  document.querySelectorAll('#zf .chip').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('#zf .chip').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      var z = b.dataset.z;
      document.querySelectorAll('.list .row').forEach(function (r) { r.style.display = (!z || r.dataset.z === z) ? '' : 'none'; });
    });
  });
  </script>
</Base>
<style>
.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:40px;align-items:center;padding:32px 0 8px}
@media (max-width:820px){.hero{grid-template-columns:1fr;gap:8px;padding-top:24px}.hero>div{order:-1}.hero :global(.clock){max-width:340px}}
.count{font-family:var(--serif);font-size:clamp(20px,3vw,26px);font-weight:700;margin:0 0 12px}
.count b{color:var(--bloom);font-weight:900}
.chip small{opacity:.65;font-variant-numeric:tabular-nums}
</style>
