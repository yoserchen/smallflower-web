---
import '../styles/global.css';
import { BRAND, AUTHOR, SITE_TITLE, FB_URL, YOUTUBE_URL, GOATCOUNTER } from '../config.mjs';
import { LIVE_CALENDARS } from '../lib.mjs';
import { videosOf } from '../videos.mjs';
const { title, description = `${AUTHOR}的花曆：什麼時候開、開在哪裡。`,
        cal = null, current = '', image = '/og.jpg', imageAlt = '' } = Astro.props;
// 兩層身分：花曆底下的頁面屬於那本花曆，其餘（首頁、故事、贊助、關於）屬於小花老師本人。
// 分開之後，個人首頁才不會頂著「小花老師的花曆」這個名字，選單也不會跑出月份和地圖。
const suffix = cal ? cal.name : AUTHOR;
const full = title ? `${title}｜${suffix}` : (cal ? suffix : SITE_TITLE);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const nc = cal;                       // 月份、地圖這些只在花曆底下出現
const home = LIVE_CALENDARS[0] || null;   // 個人頁面的選單要連到的那本花曆
// 選單只出現在兩個地方：首頁（當捷徑）和花曆底下（當工具列）。
// 導覽影片、Q故事、贊助、關於都是看完就走的單頁，不放選單比較乾淨——
// 而且「贊助」「月份」這些選項在那些頁面上本來就不成立。
const isHome = Astro.url.pathname === '/';
const showNav = !!cal || isHome;
---
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={BRAND} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt || full} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta name="author" content={AUTHOR} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&display=swap" rel="stylesheet" />
  {GOATCOUNTER && (
    <script is:inline defer data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`}
            src="//gc.zgo.at/count.js"></script>
  )}
</head>
<body>
  <header class="top"><div class="wrap">
    {/* 左上角一律是「小花老師」，一律回首頁。這是全站唯一一個固定不動的出口。 */}
    <a class="brand" href="/">
      <img src="/logo.svg" alt="" width="30" height="30" decoding="async" />
      <span>{AUTHOR}</span>
    </a>
    {showNav && (
      <nav aria-label="主選單">
        {home && <a href={`/${home.slug}/`} aria-current={current === 'cal' ? 'page' : undefined}>花曆</a>}
        {nc && <a href={`/${nc.slug}/month/`} aria-current={current === 'month' ? 'page' : undefined}>月份</a>}
        {nc && nc.hasMap && <a href={`/${nc.slug}/map/`} aria-current={current === 'map' ? 'page' : undefined}>找花地圖</a>}
        {nc && nc.passport && nc.passport.length > 0 && <a href={`/${nc.slug}/passport/`} aria-current={current === 'passport' ? 'page' : undefined}>拍花護照</a>}
        {/* 導覽影片不放選單：每一朵花的頁面上本來就有它那一區的影片，層級比較清楚 */}
        {!cal && <a href="/story/" aria-current={current === 'story' ? 'page' : undefined}>故事</a>}
        <a href="/support/" aria-current={current === 'support' ? 'page' : undefined}>贊助</a>
      </nav>
    )}
  </div></header>
  <main class="wrap"><slot /></main>
  <footer><div class="wrap">
    {/* 關於不放選單了（內容和首頁有重疊），但它寫著資料的限制，不能讓它變成孤兒，所以留在這裡 */}
    <p class="fnav"><a href="/">回{AUTHOR}首頁</a>
      <a href="/about/">關於這份花曆</a>
      <a href="/support/">贊助</a></p>
    <p class="disc">本網站資料為{AUTHOR}拍攝之花卉參考，僅供觀覽之用，並非官方網站，非作為學術上或花卉比對之作用。
      花名或有誤植、圖片錯置，也請多多指正。
      每月的花卉數量是指{AUTHOR}拍到的紀錄，並非實際的數字，也請參酌。<br />
      更多花訊請參考 FB 粉絲專頁「<a href={FB_URL} rel="noopener">{AUTHOR}</a>」，
      {YOUTUBE_URL
        ? <>更多植物園拍花導覽請到 YouTube <a href={YOUTUBE_URL} rel="noopener">小花視界</a>觀看。</>
        : <>更多植物園拍花導覽請到 YouTube「小花視界」觀看。</>}</p>
    <p class="cr">{BRAND}　資料與照片版權屬{AUTHOR}所有</p>
  </div></footer>
  <button id="totop" type="button" aria-label="回到最上面" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path d="M12 19V6M6 12l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <script is:inline>
  (function () {
    var b = document.getElementById('totop');
    if (!b) return;
    var show = function () { b.hidden = window.scrollY < 600; };
    show();
    window.addEventListener('scroll', show, { passive: true });
    b.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
  </script>
  <style>
  footer .disc{max-width:46em;margin:0 0 10px;line-height:1.85}
  footer .cr{margin:0}
  #totop{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));
    z-index:20;width:46px;height:46px;border-radius:50%;border:1px solid var(--mist);
    background:var(--paper);color:var(--ink);display:grid;place-items:center;cursor:pointer;
    box-shadow:0 2px 10px rgba(0,0,0,.14);transition:background .15s,color .15s}
  #totop[hidden]{display:none}
  #totop:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  @media print{#totop{display:none}}
  </style>
</body>
</html>
