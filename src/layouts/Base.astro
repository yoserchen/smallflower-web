---
import '../styles/global.css';
import { BRAND, AUTHOR, FB_URL, YOUTUBE_URL, GOATCOUNTER } from '../config.mjs';
import { LIVE_CALENDARS } from '../lib.mjs';
const { title, description = `${AUTHOR}的花曆：什麼時候開、開在哪裡。`,
        cal = null, current = '', image = '/og.jpg', imageAlt = '' } = Astro.props;
const suffix = cal ? cal.name : BRAND;
const full = title ? `${title}｜${suffix}` : suffix;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// 站內頁（贊助、關於）在只有一本花曆時，選單也帶出那本的月份與地圖
const nc = cal || (LIVE_CALENDARS.length === 1 ? LIVE_CALENDARS[0] : null);
---
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={BRAND} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt || full} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta name="author" content={AUTHOR} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&display=swap" rel="stylesheet" />
  {GOATCOUNTER && (
    <script is:inline defer data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`}
            src="//gc.zgo.at/count.js"></script>
  )}
</head>
<body>
  <header class="top"><div class="wrap">
    <a class="brand" href={cal ? `/${cal.slug}/` : '/'}>{cal ? cal.name : BRAND}</a>
    <nav aria-label="主選單">
      {nc && <a href={`/${nc.slug}/month/`} aria-current={current === 'month' ? 'page' : undefined}>月份</a>}
      {nc && nc.hasMap && <a href={`/${nc.slug}/map/`} aria-current={current === 'map' ? 'page' : undefined}>口袋地圖</a>}
      <a href="/support/" aria-current={current === 'support' ? 'page' : undefined}>贊助</a>
      <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>關於</a>
    </nav>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer><div class="wrap">
    {cal && <><a href="/">← 看其他花曆</a><br /></>}
    <p class="disc">本網站資料為{AUTHOR}拍攝之花卉參考，僅供觀覽之用，非作為學術上或花卉比對之作用。
      花名或有誤植、圖片錯置，也請多多指正。
      每月的花卉數量是指{AUTHOR}拍到的紀錄，並非實際的數字，也請參酌。<br />
      更多花訊請參考 FB 粉絲專頁「<a href={FB_URL} rel="noopener">{AUTHOR}</a>」，
      {YOUTUBE_URL
        ? <>更多植物園拍花導覽請到 YouTube <a href={YOUTUBE_URL} rel="noopener">小花視界</a>觀看。</>
        : <>更多植物園拍花導覽請到 YouTube「小花視界」觀看。</>}</p>
    <p class="cr">{BRAND}　資料與照片版權屬{AUTHOR}所有</p>
  </div></footer>
  <button id="totop" type="button" aria-label="回到最上面" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path d="M12 19V6M6 12l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <script is:inline>
  (function () {
    var b = document.getElementById('totop');
    if (!b) return;
    var show = function () { b.hidden = window.scrollY < 600; };
    show();
    window.addEventListener('scroll', show, { passive: true });
    b.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
  </script>
  <style>
  footer .disc{max-width:46em;margin:0 0 10px;line-height:1.85}
  footer .cr{margin:0}
  #totop{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));
    z-index:20;width:46px;height:46px;border-radius:50%;border:1px solid var(--mist);
    background:var(--paper);color:var(--ink);display:grid;place-items:center;cursor:pointer;
    box-shadow:0 2px 10px rgba(0,0,0,.14);transition:background .15s,color .15s}
  #totop[hidden]{display:none}
  #totop:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  @media print{#totop{display:none}}
  </style>
</body>
</html>
